# Переменные для docker-compose.yml в корне репозитория — запуск ВСЕГО
# проекта одной командой (docker compose up --build). Не путать с
# CSD-server/.env.example — тот для обычного локального `npm run dev` без
# Docker, читается напрямую сервером через dotenv.
#
# Ничего из этого не обязательно: без файла .env рядом с docker-compose.yml
# всё заработает на значениях по умолчанию, прописанных прямо в
# docker-compose.yml. Скопируйте в .env и правьте только то, что нужно
# изменить.

# ---------- Порты на хосте ----------
APP_PORT=5188
ADMIN_PORT=5189
SERVER_PORT=4000

# ---------- База данных ----------
POSTGRES_USER=chesslab
POSTGRES_PASSWORD=chesslab
POSTGRES_DB=chesslab

# ---------- Сервер ----------
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@chesslab.local
ADMIN_PASSWORD=change-me-strong-password

# Обычно трогать не нужно — считается из доменов ниже (см. docker-compose.yml).
ALLOWED_ORIGIN=

# ---------- ЮKassa (необязательно) ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- HTTPS-домены (Caddy сам получает сертификаты Let's Encrypt) ----------
# По умолчанию — бесплатный трюк sslip.io: любое имя вида
# "что-угодно.31-76-46-113.sslip.io" само резолвится в IP 31.76.46.113 (дефис
# вместо точек), регистрировать ничего не нужно. Меняете IP сервера — замените
# в этих трёх строках "31-76-46-113" на новый IP через дефисы. Появится
# настоящий домен — впишите его сюда вместо sslip.io-адресов, остальное
# (Caddyfile, docker-compose.yml) трогать не придётся.
APP_DOMAIN=app.31-76-46-113.sslip.io
ADMIN_DOMAIN=admin.31-76-46-113.sslip.io
API_DOMAIN=api.31-76-46-113.sslip.io

# ---------- Фронтенды ----------
# Обычно трогать не нужно — считается из API_DOMAIN выше. Переопределять
# нужно, только если хотите задать адрес API явно, в обход доменов Caddy.
VITE_API_BASE_URL=
