# Переменные для docker-compose.yml в корне репозитория — запуск ВСЕГО
# проекта одной командой (docker compose up --build). Не путать с
# CSD-server/.env.example — тот для обычного локального `npm run dev` без
# Docker, читается напрямую сервером через dotenv.
#
# Ничего из этого не обязательно: без файла .env рядом с docker-compose.yml
# всё заработает на значениях по умолчанию, прописанных прямо в
# docker-compose.yml. Скопируйте в .env и правьте только то, что нужно
# изменить.

# ---------- Порты на хосте ----------
APP_PORT=5188
ADMIN_PORT=5189
SERVER_PORT=4000

# ---------- База данных ----------
POSTGRES_USER=chesslab
POSTGRES_PASSWORD=chesslab
POSTGRES_DB=chesslab

# ---------- Сервер ----------
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@chesslab.local
ADMIN_PASSWORD=change-me-strong-password

# Нужен только при реальном деплое на домен (не localhost) — см. комментарий
# в docker-compose.yml про CORS.
ALLOWED_ORIGIN=

# ---------- ЮKassa (необязательно) ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------- Фронтенды ----------
# Адрес API, который увидит браузер — не адрес внутри докер-сети, а порт,
# опубликованный на хосте (см. SERVER_PORT выше). Переопределять нужно, только
# если меняете SERVER_PORT на что-то отличное от 4000 и хотите задать URL
# явно, а не полагаться на автоподстановку в docker-compose.yml.
VITE_API_BASE_URL=
