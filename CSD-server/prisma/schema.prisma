generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  grants       Grant[]
  emailChange  AdminEmailChange?
  passwordReset AdminPasswordReset?

  @@map("admin_users")
}

model AdminEmailChange {
  id         String    @id @default(cuid())
  adminId    String    @unique
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  newEmail   String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@map("admin_email_changes")
}

model AdminPasswordReset {
  id         String    @id @default(cuid())
  adminId    String    @unique
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@map("admin_password_resets")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String?
  name         String?
  timeZone     String?
  emailVerifiedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  payments     Payment[]
  progress     LevelProgress[]
  achievements UserAchievement[]
  grants       Grant[]
  verification EmailVerification?
  passwordReset PasswordReset?

  @@map("users")
}

model EmailVerification {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("email_verifications")
}

model PasswordReset {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("password_resets")
}

model Grant {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  grantedById  String?
  grantedBy    AdminUser? @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([assignmentId])
  @@map("grants")
}

model UserAchievement {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime  @default(now())
  seenAt     DateTime?

  @@unique([userId, key])
  @@index([userId])
  @@map("user_achievements")
}

model LevelProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId      String
  level        Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  solved       Boolean   @default(false)
  solvedAt     DateTime?
  usedSolution Boolean   @default(false)
  mistakes     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, levelId])
  @@index([userId])
  @@map("level_progress")
}

model Stage {
  id          String       @id @default(cuid())
  name        String
  description String       @default("")
  price       Float        @default(0)
  status      String       @default("draft") // draft | published | archived
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  payments    Payment[]

  @@map("stages")
}

model Assignment {
  id          String    @id @default(cuid())
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  price       Float     @default(0)
  bonus       Boolean   @default(false) // бесплатно при покупке этапа целиком
  status      String    @default("draft") // draft | published | archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  levels      Level[]
  payments    Payment[]
  grants      Grant[]

  @@index([stageId])
  @@map("assignments")
}

model Payment {
  id           String      @id @default(cuid())
  yookassaId   String      @unique
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  stageId      String?
  stage        Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  amount       Float
  currency     String      @default("RUB")
  status       String      @default("pending") // pending | succeeded | canceled
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([assignmentId])
  @@index([stageId])
  @@index([userId])
  @@map("payments")
}

model Level {
  id             String      @id @default(cuid())
  name           String
  description    String      @default("")
  solvedNote     String      @default("") // объяснение, показывается после полного решения задачи
  difficulty     String      @default("medium") // easy | medium | hard
  category       String      @default("")
  position       Json
  turn           String      @default("w") // w | b
  castling       Json
  enPassant      String?
  halfmoveClock  Int         @default(0)
  fullmoveNumber Int         @default(1)
  steps          Json
  result         String?
  status         String          @default("draft") // draft | published | archived
  assignmentId   String?
  assignment     Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  progress       LevelProgress[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([assignmentId])
  @@map("levels")
}
