DATABASE_URL="postgresql://chesslab:chesslab@localhost:5432/chesslab?schema=public"
JWT_SECRET="change-me-in-production"
# Срок жизни токена админа. Токен покупателя живёт дольше (USER_JWT_EXPIRES_IN):
# админа безопаснее разлогинивать часто, покупателя — незачем. Секрет у них
# общий, безопасно это благодаря claim'у type в токене (см. shared/jwt.js).
JWT_EXPIRES_IN="12h"
USER_JWT_EXPIRES_IN="30d"
PORT=4000
ALLOWED_ORIGIN="http://localhost:8123"
ADMIN_EMAIL="admin@chesslab.local"
ADMIN_PASSWORD="change-me-strong-password"

# Путь к нативному бинарнику Stockfish (кнопка «Рассчитать лучшее решение»).
# Windows: C:\\Program Files\\Stockfish\\stockfish.exe
# Linux/macOS: /usr/games/stockfish или /opt/homebrew/bin/stockfish
STOCKFISH_PATH=""
# Необязательные аргументы запуска движка, через пробел.
STOCKFISH_ARGS=""
STOCKFISH_DEFAULT_DEPTH=14
STOCKFISH_MAX_DEPTH=20
STOCKFISH_MAX_MOVETIME=15000

# ЮKassa (тестовый магазин, оплата задания): создать бесплатно без договора
# и данных компании — https://yookassa.ru/joinups?createTestShop=true
# Идентификатор магазина и секретный ключ берутся в личном кабинете ЮKassa.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_API_URL="https://api.yookassa.ru/v3"
# Куда вернуть покупателя после оплаты (страница "спасибо"/сайт).
PAYMENT_RETURN_URL="http://localhost:8137/index.html"
# В личном кабинете ЮKassa (Настройки магазина -> HTTP-уведомления) нужно
# прописать адрес POST-вебхука на подтверждение оплаты:
#   https://<публичный-домен-сервера>/api/payments/webhook
# Локально/на этапе разработки ЮKassa до него не достучится без туннеля
# (ngrok и т.п.).
#
# На случай, когда вебхук не дошёл, сервер сам периодически перепрашивает
# статусы своих незавершённых платежей (см. payments.sync.js) — интервал в
# миллисекундах, по умолчанию 2 минуты. Работает только при заполненных
# ключах ЮKassa выше.
PAYMENT_SYNC_INTERVAL_MS=120000
#
# Для разработки: `npm run dev:money` поднимает сервер и туннель ngrok
# одной командой (см. scripts/dev-with-tunnel.js) и печатает готовый адрес
# вебхука. Нужен бесплатный аккаунт ngrok и токен из
# https://dashboard.ngrok.com/get-started/your-authtoken.
NGROK_AUTHTOKEN=""
# Необязательно: статический домен ngrok (бесплатный аккаунт даёт один —
# https://dashboard.ngrok.com/domains). Если задать, адрес вебхука не меняется
# между запусками и не придётся каждый раз перевписывать его в ЮKassa.
NGROK_DOMAIN=""

# SMTP для писем с кодом подтверждения email при регистрации. Подходят
# реквизиты любого провайдера (Яндекс, Mail.ru, Gmail с паролем приложения,
# корпоративная почта) — используется обычный SMTP, а не API конкретного
# сервиса. Без SMTP_HOST/SMTP_USER код просто печатается в консоль сервера
# (см. shared/mailer.js) — регистрация и тесты работают и без настоящей почты.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
# Адрес и имя отправителя в письмах — "Имя <адрес>" либо просто адрес.
SMTP_FROM="ChessSchoolDinamik <no-reply@chesslab.local>"
