# Реверс-прокси перед тремя контейнерами. Caddy сам получает и продлевает
# сертификаты Let's Encrypt для каждого домена ниже — вручную ничего просить
# не нужно, только чтобы порты 80 и 443 были открыты и домены резолвились на
# этот сервер (sslip.io резолвит сам, без всякой настройки — см. .env.example).
{$APP_DOMAIN} {
	reverse_proxy app:80
}

{$ADMIN_DOMAIN} {
	reverse_proxy admin:80
}

{$API_DOMAIN} {
	reverse_proxy server:4000
}
